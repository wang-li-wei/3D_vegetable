# ================================================================
#  生菜水培数字孪生平台 - 后端环境变量配置
#  复制此文件为 .env 并修改对应的值
# ================================================================

# ===== 安全配置（必须修改）=====

# JWT 签名密钥
# 生成方法：在终端执行 openssl rand -hex 32，把输出的字符串粘贴到这里
JWT_SECRET="change-me-to-a-32-byte-random-hex"
JWT_EXPIRES_IN="24h"

# 默认管理员账号（仅首次启动时自动创建，之后可登录系统修改密码）
DEFAULT_ADMIN_USER="admin"
DEFAULT_ADMIN_PASSWORD="changeme123"

# ===== 数据库配置 =====

# PostgreSQL 连接字符串
# 格式：postgresql://用户名:密码@主机:端口/数据库名?schema=public
# 本地部署用 localhost，如果数据库在另一台服务器，改成对应 IP
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vegetable_farm?schema=public"

# ===== 服务配置 =====

# 后端 API 监听端口（前端通过 Nginx 代理访问，不需要直接暴露）
PORT=3001

# CORS 跨域配置
# 生产环境填写前端访问地址，例如 http://你的服务器IP
# 多个地址用逗号分隔，开发环境可以用 *
CORS_ORIGIN="http://localhost:3000"

# ===== MQTT 配置 =====
# 这是后端连接 MQTT Broker 的地址
#
# ┌──────────────────────────────────────────────────────────┐
# │  阿里云 IoT 平台对接说明                                  │
# │                                                          │
# │  方式一（推荐）：本地 Mosquitto + 阿里云规则引擎           │
# │    IoT 设备 → 阿里云IoT平台 → 规则引擎 → 转发到你的MQTT   │
# │    你只需保持 MQTT_BROKER 为 localhost，IoT 同学在阿里云   │
# │    控制台配置「数据流转」规则，把设备数据转发到你的服务器  │
# │    的 1883 端口。控制命令也通过规则引擎反向下发。          │
# │                                                          │
# │  方式二：直连阿里云 IoT 平台                              │
# │    后端直接连接阿里云 IoT 的 MQTT 服务                    │
# │    需要 IoT 同学提供：MQTT 域名、端口、设备三元组         │
# │    此方式数据格式（Alink JSON）与当前代码不同，            │
# │    需要额外适配层，不建议初学者使用。                     │
# └──────────────────────────────────────────────────────────┘
MQTT_BROKER="mqtt://localhost:1883"
MQTT_SUBSCRIBE_TOPIC="/lettuce/sensor/data"
MQTT_PUBLISH_TOPIC="/lettuce/control/command"

# ===== 数据保留策略 =====

# 超过此天数的传感器数据、设备状态、已处理报警会被自动清理
SENSOR_RETENTION_DAYS=30

# ===== 环境标识 =====

# 生产环境设为 production，开发环境设为 development
NODE_ENV=production
